# Copie e defina uma senha local aleatória; npm run env:init faz isso sem sobrescrever .env.
POSTGRES_USER=orders
POSTGRES_DB=orders
POSTGRES_PASSWORD=
PORT=3000
LOG_LEVEL=info
# Para rodar fora do Compose, fornecer PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# Testes de integração exigem PGDATABASE terminando em _test, e nunca usam o banco acima.
